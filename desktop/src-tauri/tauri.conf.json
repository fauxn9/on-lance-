{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "On lance",
  "version": "0.1.2",
  "identifier": "xyz.onlance.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "On lance ?",
        "width": 520,
        "height": 760,
        "resizable": true,
        "center": true,
        "visible": true,
        "minWidth": 460,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://media.valorant-api.com; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Détection de fin de partie Valorant, en direct.",
    "longDescription": "Compagnon PC d'On lance ? : lit l'état de partie exposé par le client Riot, en lecture seule, et le fait remonter au site à la seconde.",
    "publisher": "On lance ?",
    "copyright": "On lance ?",
    "category": "Game",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "On lance",
        "installerHooks": "hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REMPLACER_PAR_LA_CLE_PUBLIQUE",
      "endpoints": [
        "https://github.com/fauxn9/on-lance-/releases/latest/download/latest.json"
      ]
    }
  }
}
