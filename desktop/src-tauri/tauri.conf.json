{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "On lance",
  "version": "0.1.0",
  "identifier": "xyz.onlance.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "On lance ?",
        "width": 400,
        "height": 560,
        "resizable": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Détection de fin de partie Valorant, en direct.",
    "longDescription": "Compagnon PC d'On lance ? : lit l'état de partie exposé par le client Riot, en lecture seule, et le fait remonter au site à la seconde."
  }
}
