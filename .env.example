# --- Base de donnees -------------------------------------------------------
# Supabase : Project Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres:MOTDEPASSE@db.xxxx.supabase.co:5432/postgres
# Mettre "off" seulement pour un Postgres local sans TLS
# PGSSL=off

# --- HenrikDev (donnees Valorant) ------------------------------------------
# Cle gratuite a demander sur leur Discord
HENRIK_API_KEY=
HENRIK_RPM=25
HENRIK_MATCH_COUNT=5

# --- Anthropic (generation des messages de notif) --------------------------
# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Reglages de detection -------------------------------------------------
DETECTION_LOOKBACK_HOURS=12
DETECTION_SETTLE_MINUTES=3
DETECTION_MIN_PLAYERS=2

# --- Leaderboard hebdo (Brique 2) ------------------------------------------
# Fenetre d'import du RR (en jours) a chaque passage du cron rr:sync
RR_LOOKBACK_DAYS=14
# Fuseau qui definit ou tombe la frontiere du lundi (reset du leaderboard)
LEADERBOARD_TZ=Europe/Paris

PORT=3000

# --- Web Push --------------------------------------------------------------
# Generer une seule fois avec : npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ton@email.com

# --- Discussion avec le coach (Brique 8) -----------------------------------
# Chaque question est un appel facture sur la cle Anthropic ci-dessus.
# Fenetre glissante : CHAT_MAX questions par CHAT_FENETRE_MIN minutes et par
# personne. Monter CHAT_MAX ouvre les vannes sans toucher au code.
CHAT_MAX=3
CHAT_FENETRE_MIN=30

# --- Authentification Discord (Brique 4) -----------------------------------
# discord.com/developers/applications > ton app > OAuth2
# Redirects a declarer : <BASE_URL>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Signe les cookies de session. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Le changer deconnecte tout le monde.
SESSION_SECRET=
# Adresse publique du site : sert aux redirections OAuth et aux liens d'invitation
BASE_URL=http://localhost:3000
